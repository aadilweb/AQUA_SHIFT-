# AquaShift 2.0 Backend Configuration
PROJECT_NAME="AquaShift 2.0 API"
VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=True

# Database (Default: SQLite for local execution; uncomment for PostgreSQL/PostGIS)
DATABASE_URL="sqlite:///./aquashift.db"
# DATABASE_URL="postgresql://postgres:aquashift@localhost:5432/aquashift_db"

# Optional External API Keys
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
USER_AGENT="AquaShift-Geospatial-Platform/2.0"

# Optional LLM API Keys (Deterministic synthesis is built-in; add keys for custom fine-tuned LLM responses)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
